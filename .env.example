# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Secret key (formerly the service_role key) — server-side only, bypasses RLS.
# Never expose to the browser. Used for credit debits/credits and webhook writes.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Wiro AI — create a project at https://wiro.ai/panel/project.
# Requests are signed: x-api-key + x-nonce + x-signature, where the signature is
# HMAC-SHA256 of (API_SECRET + NONCE) keyed with the API key.
WIRO_API_KEY=your-wiro-api-key
WIRO_API_SECRET=your-wiro-api-secret
